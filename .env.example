# Local development settings (optional). System environment variables take precedence.
# LASSO_NODE_ID=local-dev

# The included public profiles require no API keys. To use a credentialed provider,
# reference its variable in config/profiles/<slug>.yml, for example:
#   url: "https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}"
# Then set the variable here or in the process environment:
# ALCHEMY_API_KEY=replace-with-your-provider-key
# See docs/CONFIGURATION.md for provider URL and header configuration.
