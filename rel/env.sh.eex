#!/bin/sh

# Release environment setup
# This script runs BEFORE runtime.exs, setting env vars that config will read

# Distribution serves clustering and operator commands such as `lasso reload`.
# Without RELEASE_COOKIE the node would use the cookie written into the release
# at build time, which everyone with the same download shares, so distribution
# stays off unless a cookie or a cluster is configured.
if [ -z "${RELEASE_DISTRIBUTION:-}" ]; then
  if [ -n "${RELEASE_COOKIE:-}" ] || [ -n "${CLUSTER_DNS_QUERY:-}" ]; then
    RELEASE_DISTRIBUTION="name"
  else
    RELEASE_DISTRIBUTION="none"
  fi
fi
export RELEASE_DISTRIBUTION

if [ "$RELEASE_DISTRIBUTION" = "none" ]; then
  case "${RELEASE_COMMAND:-}" in
    rpc | remote | stop | restart | pid)
      echo "lasso: '$RELEASE_COMMAND' reaches the running node over distribution, which is off because RELEASE_COOKIE is not set. Start the node with RELEASE_COOKIE set to use it, or stop the node with SIGTERM." >&2
      exit 1
      ;;
  esac
fi

# Default node name if not set by deployment environment
# Format: appname@hostname (e.g., lasso@127.0.0.1)
export RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@127.0.0.1}"

# Uncomment to send crash dumps to stderr (useful for debugging)
# export ERL_CRASH_DUMP=/dev/stderr
# export ERL_CRASH_DUMP_BYTES=4096
